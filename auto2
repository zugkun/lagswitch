local function ToggleAntiNextbot(enabled)
    if enabled then
        if AntiNextbotConn then AntiNextbotConn:Disconnect() end
        AntiNextbotConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local nextbots = {}
            local npcs = Workspace:FindFirstChild("NPCs")
            if npcs then
                for _, npc in ipairs(npcs:GetChildren()) do
                    if npc:IsA("Model") then table.insert(nextbots, npc) end
                end
            end
            
            local gameFolder = Workspace:FindFirstChild("Game")
            local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")
            if playersFolder then
                for _, npc in ipairs(playersFolder:GetChildren()) do
                    if npc:IsA("Model") and npc.Name ~= LocalPlayer.Name then table.insert(nextbots, npc) end
                end
            end
            
            for _, npc in ipairs(nextbots) do
                local nHrp = npc:FindFirstChild("HumanoidRootPart")
                if nHrp and (hrp.Position - nHrp.Position).Magnitude < 45 then
                    if State.SafePlatform then
                        hrp.CFrame = CFrame.new(State.SafeZonePos + Vector3.new(0, 3, 0))
                    else
                        -- Fallback: Teleport to random alive player
                        local validPlayers = {}
                        for _, plr in ipairs(Players:GetPlayers()) do
                            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                                local isDowned = plr.Character:GetAttribute("Downed")
                                if not isDowned then table.insert(validPlayers, plr) end
                            end
                        end
                        if #validPlayers > 0 then
                            local rp = validPlayers[math.random(1, #validPlayers)]
                            hrp.CFrame = rp.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                        end
                    end
                    SetStatus("Dodging Nextbot!", Color3.fromRGB(255, 80, 80))
                    break -- Teleport once per frame
                end
            end
        end)
    else
        if AntiNextbotConn then AntiNextbotConn:Disconnect(); AntiNextbotConn = nil end
    end
end

