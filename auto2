local function SendWebhook(title, description, color, fields)
    local requestFunc = nil
    pcall(function()
        local env = (getgenv and getgenv()) or _G or shared or {}
        requestFunc = (env.syn and env.syn.request) or (env.http and env.http.request) or env.http_request or (env.fluxus and env.fluxus.request) or env.request or (type(request) ~= "nil" and request) or nil
    end)
    
    if type(requestFunc) ~= "function" then 
        warn("Elite Webhook Error: Executor Anda tidak memiliki fungsi HTTP Request (requestFunc nil)")
        Notify("Webhook Error", "Fungsi HTTP tidak ditemukan di Executor ini!", 5)
        return 
    end
    
    local userId = 0
    pcall(function() userId = LocalPlayer.UserId end)
    if userId == 0 then return end
    local OSTime = os.time()
    local Time = os.date("!*t", OSTime)
    local placeId = game.PlaceId
    local jobId = game.JobId
    local playerUrl = string.format("https://www.roblox.com/users/%d/profile", userId)
    local joinUrl = string.format("https://www.roblox.com/games/start?placeId=%d&jobId=%s", placeId, jobId)
    local embedFields = {
        { name = "👤 Player", value = string.format("[%s](%s) | UID: `%d`", LocalPlayer.Name, playerUrl, userId), inline = true },
        { name = "🎮 Server", value = string.format("[Join Server](%s)\nPlace ID: `%d`", joinUrl, placeId), inline = true }
    }
    if fields then for _, f in ipairs(fields) do table.insert(embedFields, f) end end
    local embed = {
        title = title,
        description = description,
        color = color or 5814783,
        fields = embedFields,
        timestamp = string.format("%d-%02d-%02dT%02d:%02d:%02dZ", Time.year, Time.month, Time.day, Time.hour, Time.min, Time.sec),
        footer = { text = "Evade AutoTicket v4 | Elite Farm", icon_url = "https://cdn.discordapp.com/embed/avatars/4.png" },
        thumbnail = { url = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=150&height=150&format=png", userId) }
    }
    
    task.spawn(function()
        local ok, response = pcall(function()
            Notify("Elite Webhook", "Mengirim data statistik ke Discord...", 3)
            return requestFunc({
                Url = WEBHOOK_URL, 
                Method = "POST", 
                Headers = { ["Content-Type"] = "application/json" }, 
                Body = HttpService:JSONEncode({ embeds = { embed } })
            })
        end)
        
        if not ok then
            warn("[Elite Webhook] Execution Error:", tostring(response))
        else
            if type(response) == "table" then
                local statusCode = response.StatusCode or response.Status or "N/A"
                local success = response.Success
                local body = response.Body or "N/A"
                if success == false or (type(statusCode) == "number" and statusCode >= 400) then
                    warn(string.format("[Elite Webhook] API Error! Code: %s | Success: %s | Body: %s", tostring(statusCode), tostring(success), tostring(body)))
                else
                    print(string.format("[Elite Webhook] Payload sukses dikirim! Code: %s", tostring(statusCode)))
                end
            else
                warn("[Elite Webhook] Unrecognized response format:", tostring(response))
            end
        end
    end)
end

