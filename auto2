local function GetMapName()
    local mapObj = Workspace:FindFirstChild("Map") or (Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Map"))
    if mapObj then
        local attr = mapObj:GetAttribute("MapName") or mapObj:GetAttribute("Name")
        if attr and type(attr) == "string" and #attr > 0 then return attr end
        if mapObj.Name ~= "Map" then return mapObj.Name end
        for _, child in ipairs(mapObj:GetChildren()) do
            if (child:IsA("Model") or child:IsA("Folder")) and child.Name ~= "Settings" then return child.Name end
        end
        return "Map"
    end
    local ok, res = pcall(function()
        local svc = ReplicatedStorage:FindFirstChild("Services")
        local regMod = svc and svc:FindFirstChild("Data") and svc.Data:FindFirstChild("ServerStateRegistryService")
        if regMod then return require(regMod):Get("MapName") or require(regMod):Get("Map") end
    end)
    if ok and res and type(res) == "string" and #res > 0 then return res end
    return "Intermission"
end

