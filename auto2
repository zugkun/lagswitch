local function formatNumber(n)
    if not n then return "0" end
    local formatted = tostring(n)
    while true do
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

local function GetPlayerStats()
    local points = 0
    local tokens = 0
    local level = 0
    local xp = 0
    local streak = 0
    local timeAlive = 0
    local status = "SURVIVED 🏆"
    
    pcall(function()
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                status = "DIED 💀"
            end
        else
            status = "DIED 💀"
        end
    end)

    pcall(function()
        local aPoints = LocalPlayer:GetAttribute("Points")
        if aPoints then points = aPoints end
        local aTokens = LocalPlayer:GetAttribute("Tokens")
        if aTokens then tokens = aTokens end
        local aLevel = LocalPlayer:GetAttribute("Level")
        if aLevel then level = aLevel end
        local aXp = LocalPlayer:GetAttribute("Experience")
        if aXp then xp = aXp end
    end)

    pcall(function()
        local charSvc = ReplicatedStorage:FindFirstChild("Services") and ReplicatedStorage.Services:FindFirstChild("Asset") and ReplicatedStorage.Services.Asset:FindFirstChild("CharacterService")
        if charSvc then
            local svc = require(charSvc)
            local charData = svc:GetCharacterFromPlayer(LocalPlayer)
            if charData and charData.DataRegistry then
                local cPoints = charData.DataRegistry:Get("Points")
                if cPoints and cPoints > 0 then points = cPoints end
                local cTokens = charData.DataRegistry:Get("Tokens")
                if cTokens and cTokens > 0 then tokens = cTokens end
                local cLevel = charData.DataRegistry:Get("Level")
                if cLevel and cLevel > 0 then level = cLevel end
                local cXp = charData.DataRegistry:Get("Experience")
                if cXp and cXp > 0 then xp = cXp end
                local cStreak = charData.DataRegistry:Get("Streak")
                if cStreak then streak = cStreak end
                local cTimeAlive = charData.DataRegistry:Get("TimeAlive")
                if cTimeAlive then timeAlive = cTimeAlive end
                
                local state = charData.DataRegistry:Get("State")
                local downed = charData.DataRegistry:Get("Downed")
                if state == "Downed" or downed then
                    status = "SURVIVED (DOWNED) 🩹"
                elseif state == "Dead" then
                    status = "DIED 💀"
                end
            end
        end
    end)

    pcall(function()
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        if leaderstats then
            local lPoints = leaderstats:FindFirstChild("Points") or leaderstats:FindFirstChild("Credits") or leaderstats:FindFirstChild("Cash")
            if lPoints and tonumber(lPoints.Value) and tonumber(lPoints.Value) > 0 then points = tonumber(lPoints.Value) end
            local lTokens = leaderstats:FindFirstChild("Tokens")
            if lTokens and tonumber(lTokens.Value) and tonumber(lTokens.Value) > 0 then tokens = tonumber(lTokens.Value) end
            local lLevel = leaderstats:FindFirstChild("Level")
            if lLevel and tonumber(lLevel.Value) and tonumber(lLevel.Value) > 0 then level = tonumber(lLevel.Value) end
        end
    end)
    
    local totalTickets = 0
    pcall(function()
        local useEvent = ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("UserData") and ReplicatedStorage.Shared.UserData:FindFirstChild("ClientHooks") and ReplicatedStorage.Shared.UserData.ClientHooks:FindFirstChild("useEvent")
        if useEvent then
            pcall(function() totalTickets = require(useEvent).Balance() or 0 end)
        end
    end)
    
    pcall(function()
        local hooks = ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("UserData") and ReplicatedStorage.Shared.UserData:FindFirstChild("ClientHooks")
        if hooks and hooks:FindFirstChild("useProfile") then
            local prof = require(hooks.useProfile)()
            if type(prof) == "table" then
                if prof.Points and tonumber(prof.Points) and tonumber(prof.Points) > points then points = tonumber(prof.Points) end
                if prof.Tokens and tonumber(prof.Tokens) and tonumber(prof.Tokens) > tokens then tokens = tonumber(prof.Tokens) end
                if prof.Level and tonumber(prof.Level) and tonumber(prof.Level) > level then level = tonumber(prof.Level) end
            end
        end
    end)
    
    pcall(function()
        if points == 0 or tokens == 0 or level == 0 then
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then
                for _, v in ipairs(pg:GetDescendants()) do
                    if v:IsA("TextLabel") and v.Text ~= "" then
                        local text = v.Text
                        local upperText = text:upper()
                        
                        if upperText:match("^LEVEL%s*(%d+)") then
                            local lvl = tonumber(upperText:match("^LEVEL%s*(%d+)"))
                            if lvl and lvl > level then level = lvl end
                        end
                        
                        if text:match("^(%d+)/(%d+)$") then
                            local curXp = tonumber(text:match("^(%d+)/"))
                            if curXp and curXp > xp then xp = curXp end
                        end
                        
                        local numStr = text:gsub(",", "")
                        local num = tonumber(numStr)
                        if num then
                            local name = v.Name:lower()
                            local parentName = v.Parent and v.Parent.Name:lower() or ""
                            if name:match("point") or parentName:match("point") then
                                if num > points then points = num end
                            elseif name:match("token") or parentName:match("token") then
                                if num > tokens then tokens = num end
                            elseif name:match("level") or parentName:match("level") then
                                if num > level then level = num end
                            end
                        end
                    end
                end
            end
        end
    end)
    
    points = tonumber(points) or 0
    tokens = tonumber(tokens) or 0
    level = tonumber(level) or 0
    xp = tonumber(xp) or 0
    streak = tonumber(streak) or 0
    timeAlive = tonumber(timeAlive) or 0
    totalTickets = tonumber(totalTickets) or 0
    
    return points, tokens, level, xp, streak, timeAlive, status, totalTickets
end

